{
  "expo": {
    "name": "AURORA Mail",
    "slug": "aurora-mail",
    "scheme": "aurora-mail",
    "version": "2.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": { "CADisableMinimumFrameDurationOnPhone": true }
    },
    "android": { "adaptiveIcon": { "backgroundColor": "#111318" } },
    "plugins": ["expo-secure-store"]
  }
}
